# Browser-safe Supabase project values. RLS applies to all user data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret key. Used only by the authenticated n8n callback
# to atomically save processing results; never expose this in browser code.
SUPABASE_SECRET_KEY=

APP_BASE_URL=http://localhost:3000

# Server-only. Set only after Header Auth is configured on the n8n Webhook.
# Leave the URL blank while the n8n workflow is inactive or only acknowledges intake.
N8N_CLAIM_INTAKE_WEBHOOK_URL=
N8N_WEBHOOK_AUTH_TOKEN=

# Server-only shared secret for authenticating n8n processing callbacks.
N8N_CALLBACK_SECRET=

# Configure only after the n8n workflow has a Groq credential and verified model.
GROQ_API_KEY=
GROQ_MODEL=
