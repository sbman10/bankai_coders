# Browser-safe Supabase project values. RLS applies to all user data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret key. Used for trusted document indexing and the
# authenticated n8n callback; never expose this in browser code.
SUPABASE_SECRET_KEY=

APP_BASE_URL=http://localhost:3000

# Server-only. Set only after Header Auth is configured on the n8n Webhook.
# Leave the URL blank while the n8n workflow is inactive or only acknowledges intake.
N8N_CLAIM_INTAKE_WEBHOOK_URL=
N8N_AMAZON_IMPORT_WEBHOOK_URL=
N8N_WEBHOOK_AUTH_TOKEN=

# Server-only shared secret for authenticating n8n processing callbacks.
N8N_CALLBACK_SECRET=

# Configure only after the n8n workflow has a Groq credential and verified model.
GROQ_API_KEY=
GROQ_MODEL=

# Google Cloud Vision API (Server-only). Used for document text detection & OCR.
# Option A: Path to Google Service Account JSON keyfile
GOOGLE_APPLICATION_CREDENTIALS=
# Option B: Direct Service Account credentials or API key
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_CLIENT_EMAIL=
GOOGLE_CLOUD_PRIVATE_KEY=
GOOGLE_CLOUD_VISION_API_KEY=

# OpenAI API (Server-only). Used for structured extraction from OCR text.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

