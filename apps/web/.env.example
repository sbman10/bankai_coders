# Browser-safe Supabase project values. RLS applies to all user data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret key. Used for trusted document indexing and the
# authenticated n8n callback; never expose this in browser code.
SUPABASE_SECRET_KEY=

APP_BASE_URL=http://localhost:3000

# Server-only. Set only after Header Auth is configured on the n8n Webhook.
# Leave the URL blank while the n8n workflow is inactive or only acknowledges intake.
N8N_CLAIM_INTAKE_WEBHOOK_URL=
N8N_AMAZON_IMPORT_WEBHOOK_URL=
N8N_WEBHOOK_AUTH_TOKEN=

# Server-only shared secret for authenticating n8n -> ProductVault claim processing.
# Configure a matching n8n HTTP Request custom-auth credential with header
# x-claimforge-callback-secret. Keep it distinct from N8N_WEBHOOK_AUTH_TOKEN.
N8N_CALLBACK_SECRET=

# Server-only Groq configuration used by the ProductVault app to prepare cited
# claim reviews. Extracted invoice/warranty text is sent to Groq; it is never sent to n8n.
GROQ_API_KEY=
GROQ_MODEL=

# Google Cloud Vision API (Server-only). Used for document text detection & OCR.
# Option A: Path to Google Service Account JSON keyfile
GOOGLE_APPLICATION_CREDENTIALS=
# Option B: Direct Service Account credentials or API key
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_CLIENT_EMAIL=
GOOGLE_CLOUD_PRIVATE_KEY=
GOOGLE_CLOUD_VISION_API_KEY=

# OpenAI API (Server-only). Used for structured extraction from OCR text.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Firecrawl API (Server-only). Used for reliable cross-store product data acquisition.
FIRECRAWL_API_KEY=

# Server-only daily reminders, price checks, and optional email delivery.
# Configure matching n8n Header Auth with x-productvault-scheduler-secret.
N8N_REMINDERS_SECRET=
# Keep this false/unset until the reminders workflow is configured and tested.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
